# Copy this file to .env and adjust if needed (.env is gitignored — safe to edit locally).
# VITE_* vars are read at build time and inlined into the frontend bundle.

# Backend API base. Leave commented out for local dev — it already defaults to
# http://localhost:5000/api, which matches the Flask server in this guide.
# VITE_API_URL=http://localhost:5000/api

# Optional: CARTO Basemaps API key — removes the "API key required" watermark on the
# map's raster tiles. The map works fine without it. Free, up to 5,000,000 tile
# requests/month: sign up at https://carto.com/basemaps and paste your key below.
# VITE_CARTO_API_KEY=your_carto_key_here
