# Copy this to backend/.env and fill in real values.
# (setup_db.ps1 writes backend/.env for you automatically — this file is just a reference.)

# SQLAlchemy connection string. Format:
#   postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/agrika_gis

# Secret used to sign login tokens — any long random string.
JWT_SECRET_KEY=change-this-to-a-long-random-string

# Frontend origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173
