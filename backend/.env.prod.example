# Production database (Supabase) — for pushing predictions/features to the
# database the Render app reads. Copy this file to `.env.prod` (gitignored) and
# paste your Supabase connection string. Do NOT commit .env.prod.
#
#   cp backend/.env.prod.example backend/.env.prod
#   # then edit backend/.env.prod and paste the URL
#
# Supabase: Project -> Settings -> Database -> Connection string (URI).
# Use the direct/session connection (port 5432). postgres:// is fine; the app
# rewrites it automatically.
PROD_DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
